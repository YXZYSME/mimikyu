---
import release from '../data/release.json';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<section id="architecture" class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="font-mono text-xs font-bold uppercase tracking-widest text-[#FF6B8B]">
        04 // RUNTIME TOPOLOGY &amp; R3 SECURITY BOUNDARY
      </p>
      <h2 class="mt-1 font-mono text-2xl font-extrabold text-[#F4EEFF] sm:text-3xl">
        Deterministic Architecture, Zero Leak Surface
      </h2>
    </div>
    <a
      href={`${base}docs/architecture`}
      class="hud-btn-ghost px-3.5 py-2 font-mono text-xs font-semibold text-[#4CE0B3]"
    >
      Read ARCHITECTURE.md →
    </a>
  </div>

  <!-- Inline Dark-Mode SVG Architecture Diagram -->
  <div class="hud-frame overflow-x-auto p-4 sm:p-6">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2 font-mono text-[11px] text-[#C9B8F5]">
      <span class="font-bold text-[#FFE47A]">CONTROL PLANE DATAFLOW</span>
      <span>CLI/MCP → Unix Daemon → Tier 1/2 Isolation → Local ProxyRelay → CDP / BiDi</span>
    </div>

    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 1040 310"
      role="img"
      aria-label="mimikyu architecture: CLI and MCP connect through Warm Unix Daemon to Tier 1/2 Isolation, Local ProxyRelay, and dual Chromium CDP and Firefox BiDi engines"
      class="h-auto w-full min-w-[720px]"
    >
      <defs>
        <marker id="arrow-gold" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M 0 1 L 10 5 L 0 9 z" fill="#F5B841" />
        </marker>
        <marker id="arrow-mint" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M 0 1 L 10 5 L 0 9 z" fill="#4CE0B3" />
        </marker>
        <marker id="arrow-violet" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M 0 1 L 10 5 L 0 9 z" fill="#9D80EB" />
        </marker>
      </defs>

      <!-- Canvas -->
      <rect x="0" y="0" width="1040" height="310" fill="#090414" stroke="#563A9E" stroke-width="2" />

      <!-- Node 1: CLI / MCP -->
      <rect x="20" y="42" width="170" height="226" fill="#180D2E" stroke="#F5B841" stroke-width="2" />
      <rect x="20" y="42" width="170" height="28" fill="#22133F" />
      <text x="105" y="61" text-anchor="middle" fill="#FFE47A" font-family="JetBrains Mono, monospace" font-size="11" font-weight="700">1. FRONTENDS</text>
      <rect x="34" y="86" width="142" height="70" fill="#120924" stroke="#563A9E" stroke-width="1.5" />
      <text x="105" y="110" text-anchor="middle" fill="#F4EEFF" font-family="JetBrains Mono, monospace" font-size="12" font-weight="700">mimikyu CLI</text>
      <text x="105" y="129" text-anchor="middle" fill="#C9B8F5" font-family="JetBrains Mono, monospace" font-size="10">--json envelope</text>
      <text x="105" y="145" text-anchor="middle" fill="#4CE0B3" font-family="JetBrains Mono, monospace" font-size="10">batch · snapshot</text>

      <rect x="34" y="176" width="142" height="74" fill="#120924" stroke="#9D80EB" stroke-width="1.5" />
      <text x="105" y="200" text-anchor="middle" fill="#F4EEFF" font-family="JetBrains Mono, monospace" font-size="12" font-weight="700">mimikyu mcp</text>
      <text x="105" y="219" text-anchor="middle" fill="#C9B8F5" font-family="JetBrains Mono, monospace" font-size="10">Stdio JSON-RPC 2.0</text>
      <text x="105" y="236" text-anchor="middle" fill="#9D80EB" font-family="JetBrains Mono, monospace" font-size="10">{release.mcp.total} MCP tools</text>

      <!-- Arrow 1 -> 2 -->
      <line x1="190" y1="155" x2="228" y2="155" stroke="#F5B841" stroke-width="2.5" marker-end="url(#arrow-gold)" />

      <!-- Node 2: Warm Unix Daemon -->
      <rect x="232" y="42" width="176" height="226" fill="#180D2E" stroke="#9D80EB" stroke-width="2" />
      <rect x="232" y="42" width="176" height="28" fill="#22133F" />
      <text x="320" y="61" text-anchor="middle" fill="#C9B8F5" font-family="JetBrains Mono, monospace" font-size="11" font-weight="700">2. UNIX DAEMON</text>
      <text x="320" y="102" text-anchor="middle" fill="#F4EEFF" font-family="JetBrains Mono, monospace" font-size="12" font-weight="700">daemon.sock</text>
      <text x="320" y="122" text-anchor="middle" fill="#4CE0B3" font-family="JetBrains Mono, monospace" font-size="10">NDJSON RPC · 0600</text>
      <line x1="250" y1="138" x2="390" y2="138" stroke="#563A9E" stroke-dasharray="4 4" />
      <text x="320" y="162" text-anchor="middle" fill="#FFE47A" font-family="JetBrains Mono, monospace" font-size="11" font-weight="700">SessionManager</text>
      <text x="320" y="182" text-anchor="middle" fill="#C9B8F5" font-family="JetBrains Mono, monospace" font-size="10">ChokepointInput</text>
      <text x="320" y="200" text-anchor="middle" fill="#C9B8F5" font-family="JetBrains Mono, monospace" font-size="10">@eN Snapshot + Diff</text>
      <text x="320" y="218" text-anchor="middle" fill="#C9B8F5" font-family="JetBrains Mono, monospace" font-size="10">Auto-spawn &amp; Idle Reap</text>
      <text x="320" y="246" text-anchor="middle" fill="#9D80EB" font-family="JetBrains Mono, monospace" font-size="9">Zero Node / Python</text>

      <!-- Arrow 2 -> 3 -->
      <line x1="408" y1="155" x2="446" y2="155" stroke="#9D80EB" stroke-width="2.5" marker-end="url(#arrow-violet)" />

      <!-- Node 3: Tier 1 / 2 Isolation -->
      <rect x="450" y="42" width="184" height="226" fill="#180D2E" stroke="#4CE0B3" stroke-width="2" />
      <rect x="450" y="42" width="184" height="28" fill="#22133F" />
      <text x="542" y="61" text-anchor="middle" fill="#9EFCE4" font-family="JetBrains Mono, monospace" font-size="11" font-weight="700">3. TIER 1 / 2 ISOLATION</text>
      <rect x="464" y="86" width="156" height="72" fill="#120924" stroke="#563A9E" stroke-width="1.5" />
      <text x="542" y="108" text-anchor="middle" fill="#FFE47A" font-family="JetBrains Mono, monospace" font-size="11" font-weight="700">Tier 1 · Process/Disk</text>
      <text x="542" y="126" text-anchor="middle" fill="#C9B8F5" font-family="JetBrains Mono, monospace" font-size="10">fs2 locked --profile</text>
      <text x="542" y="144" text-anchor="middle" fill="#C9B8F5" font-family="JetBrains Mono, monospace" font-size="10">or --ephemeral tempdir</text>

      <rect x="464" y="176" width="156" height="74" fill="#120924" stroke="#4CE0B3" stroke-width="1.5" />
      <text x="542" y="198" text-anchor="middle" fill="#9EFCE4" font-family="JetBrains Mono, monospace" font-size="11" font-weight="700">Tier 2 · Virtual Pool</text>
      <text x="542" y="217" text-anchor="middle" fill="#C9B8F5" font-family="JetBrains Mono, monospace" font-size="10">--virtual contexts</text>
      <text x="542" y="235" text-anchor="middle" fill="#FFE47A" font-family="JetBrains Mono, monospace" font-size="10">67.1 ms warm alloc</text>

      <!-- Arrow 3 -> 4 -->
      <line x1="634" y1="155" x2="672" y2="155" stroke="#4CE0B3" stroke-width="2.5" marker-end="url(#arrow-mint)" />

      <!-- Node 4: Local ProxyRelay & Env Coherence -->
      <rect x="676" y="42" width="156" height="226" fill="#180D2E" stroke="#FF6B8B" stroke-width="2" />
      <rect x="676" y="42" width="156" height="28" fill="#22133F" />
      <text x="754" y="61" text-anchor="middle" fill="#FF6B8B" font-family="JetBrains Mono, monospace" font-size="11" font-weight="700">4. PROXY &amp; ENV</text>
      <text x="754" y="102" text-anchor="middle" fill="#F4EEFF" font-family="JetBrains Mono, monospace" font-size="11" font-weight="700">Local ProxyRelay</text>
      <text x="754" y="121" text-anchor="middle" fill="#FF6B8B" font-family="JetBrains Mono, monospace" font-size="10">127.0.0.1:0 loopback</text>
      <text x="754" y="140" text-anchor="middle" fill="#C9B8F5" font-family="JetBrains Mono, monospace" font-size="9">Auth HTTP/SOCKS5</text>
      <text x="754" y="155" text-anchor="middle" fill="#C9B8F5" font-family="JetBrains Mono, monospace" font-size="9">Zero CLI cred leaks</text>
      <line x1="690" y1="172" x2="818" y2="172" stroke="#563A9E" stroke-dasharray="4 4" />
      <text x="754" y="196" text-anchor="middle" fill="#FFE47A" font-family="JetBrains Mono, monospace" font-size="10" font-weight="700">Env Coherence</text>
      <text x="754" y="215" text-anchor="middle" fill="#C9B8F5" font-family="JetBrains Mono, monospace" font-size="9">win11 | macos | linux</text>
      <text x="754" y="232" text-anchor="middle" fill="#C9B8F5" font-family="JetBrains Mono, monospace" font-size="9">Offline GeoIP</text>
      <text x="754" y="249" text-anchor="middle" fill="#C9B8F5" font-family="JetBrains Mono, monospace" font-size="9">Resource Blocker</text>

      <!-- Arrows 4 -> 5a & 5b -->
      <line x1="832" y1="114" x2="866" y2="114" stroke="#F5B841" stroke-width="2.5" marker-end="url(#arrow-gold)" />
      <line x1="832" y1="210" x2="866" y2="210" stroke="#4CE0B3" stroke-width="2.5" marker-end="url(#arrow-mint)" />

      <!-- Node 5: Dual Engines -->
      <rect x="870" y="42" width="150" height="106" fill="#22133F" stroke="#F5B841" stroke-width="2" />
      <text x="945" y="72" text-anchor="middle" fill="#FFE47A" font-family="JetBrains Mono, monospace" font-size="12" font-weight="800">Chromium</text>
      <text x="945" y="92" text-anchor="middle" fill="#F4EEFF" font-family="JetBrains Mono, monospace" font-size="10">Native WebSocket CDP</text>
      <text x="945" y="112" text-anchor="middle" fill="#C9B8F5" font-family="JetBrains Mono, monospace" font-size="9">5.0 ms snapshot</text>
      <text x="945" y="130" text-anchor="middle" fill="#C9B8F5" font-family="JetBrains Mono, monospace" font-size="9">setpgid(0, 0) reaped</text>

      <rect x="870" y="162" width="150" height="106" fill="#22133F" stroke="#4CE0B3" stroke-width="2" />
      <text x="945" y="192" text-anchor="middle" fill="#9EFCE4" font-family="JetBrains Mono, monospace" font-size="12" font-weight="800">Firefox / Gecko</text>
      <text x="945" y="212" text-anchor="middle" fill="#F4EEFF" font-family="JetBrains Mono, monospace" font-size="10">W3C WebDriver BiDi</text>
      <text x="945" y="232" text-anchor="middle" fill="#C9B8F5" font-family="JetBrains Mono, monospace" font-size="9">3.57× token ratio</text>
      <text x="945" y="250" text-anchor="middle" fill="#C9B8F5" font-family="JetBrains Mono, monospace" font-size="9">Zero-spawn discovery</text>

      <!-- Bottom invariant rail -->
      <text x="520" y="294" text-anchor="middle" fill="#9D80EB" font-family="JetBrains Mono, monospace" font-size="10">
        INVARIANT: Zero raw CDP/BiDi protocol types leak above DriverSession · Graceful Browser.close + POSIX process-group teardown
      </text>
    </svg>
  </div>

  <!-- R3 Security & Privacy Boundary Card (#FF6B8B) -->
  <div class="mt-8 border-2 border-[#FF6B8B] bg-[#180D2E] p-6 shadow-[5px_5px_0_0_#090414] sm:p-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-2 border border-[#FF6B8B] bg-[#FF6B8B]/15 px-2.5 py-1 font-mono text-[11px] font-bold uppercase tracking-widest text-[#FF6B8B]">
          <span>■</span>
          <span>R3 Security &amp; Privacy Boundary</span>
        </div>
        <h3 class="mt-3 font-mono text-xl font-extrabold text-[#F4EEFF]">
          Strict General-Purpose Automation Scope — Hardened by Default
        </h3>
      </div>
      <a
        href={`${base}docs/security`}
        class="border-2 border-[#FF6B8B] bg-[#120924] px-3.5 py-2 font-mono text-xs font-bold text-[#FF6B8B] transition-colors hover:bg-[#FF6B8B] hover:text-[#090414]"
      >
        Read SECURITY.md →
      </a>
    </div>

    <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      <div class="border border-[#FF6B8B]/50 bg-[#120924] p-4">
        <div class="font-mono text-xs font-bold text-[#FF6B8B]">Zero Anti-Bot / CAPTCHA Bypass</div>
        <p class="mt-1.5 text-xs leading-relaxed text-[#C9B8F5]">
          <code class="font-mono text-[#FFE47A]">mimikyu</code> intentionally excludes any CAPTCHA solver,
          human-verification bypass, proof-of-work cracker, or anti-bot gate circumvention across both
          <code class="font-mono text-[#F4EEFF]">crates/</code> and <code class="font-mono text-[#F4EEFF]">e2e/</code>.
        </p>
      </div>

      <div class="border border-[#FF6B8B]/50 bg-[#120924] p-4">
        <div class="font-mono text-xs font-bold text-[#FFE47A]">Loopback ProxyRelay Credential Isolation</div>
        <p class="mt-1.5 text-xs leading-relaxed text-[#C9B8F5]">
          Authenticated HTTP and SOCKS5 upstream proxies terminate in a local
          <code class="font-mono text-[#4CE0B3]">127.0.0.1:0</code> relay so credentials never appear in
          <code class="font-mono text-[#F4EEFF]">ps</code> process arguments or browser profiles.
        </p>
      </div>

      <div class="border border-[#FF6B8B]/50 bg-[#120924] p-4">
        <div class="font-mono text-xs font-bold text-[#4CE0B3]">Sandboxed World &amp; Process Hygiene</div>
        <p class="mt-1.5 text-xs leading-relaxed text-[#C9B8F5]">
          <code class="font-mono text-[#F4EEFF]">mimikyu eval</code> defaults to an isolated JS world (explicit
          <code class="font-mono text-[#FFE47A]">--main-world</code> opt-in), with zero-spawn macOS Firefox metadata
          probes and <code class="font-mono text-[#F4EEFF]">setpgid(0, 0)</code> zero-orphan reaping.
        </p>
      </div>
    </div>
  </div>
</section>
